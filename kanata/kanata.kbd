(defsrc
  grv  1    2    3    4    5    6    7    8    9    0    -    =    bspc
  tab  q    w    e    r    t    y    u    i    o    p    [    ]    \
  caps a    s    d    f    g    h    j    k    l    ;    '    ret
  lsft z    x    c    v    b    n    m    ,    .    /    rsft
)

(deflayer graphite
  grv  1    2    3    4    5    6    7    8    9    0    [    ]    bspc
  tab  b    l    d    w    z    '    f    o    u    j    ;    =    \
  caps n    r    t    s    g    y    h    a    e    i    ,    ret
  lsft q    x    m    c    v    k    p    .    -    /    rsft
)

;; The keyboard sends shift keys literally, like `shift + ;`.
;; Then the OS decides what key it should become based on the selected layout.
;; For example: `shift + . = >` and `shift + / = ?`.
;; Since Graphite changes the punctuation around we have to lie to the OS to get the character we want.
(defoverrides
  (lshft -) (lshft ')
  (rshft -) (rshft ')

  (lshft ') (lshft -)
  (rshft ') (rshft -)

  (lshft /) (lshft ,)
  (rshft /) (rshft ,)

  (lshft ,) (lshft /)
  (rshft ,) (rshft /)
)

(defcfg
  process-unmapped-keys no ;; You might want to enable this if you want to extend this config: https://jtroo.github.io/config.html#process-unmapped-keys
)
